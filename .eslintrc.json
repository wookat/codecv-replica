{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true,
    "vue/setup-compiler-macros": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:vue/vue3-essential",
    "plugin:@typescript-eslint/recommended",
    "plugin:prettier/recommended"
  ],
  "parser": "vue-eslint-parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "parser": "@typescript-eslint/parser",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["vue", "@typescript-eslint"],
  "rules": {
    "prettier/prettier": "error",
    "vue/no-v-html": "off",
    "vue/max-attributes-per-line": "off",
    "vue/multi-word-component-names": "off",
    "vue/no-multiple-template-root": "off",
    "vue/component-definition-name-casing": ["warn", "kebab-case"],
    "no-debugger": "off",
    "no-console": "off",
    "@typescript-eslint/no-explicit-any": ["off"]
  },
  "globals": {
    "defineOptions": "writable"
  },
  "overrides": [
    {
      "files": ["nuxt-app/**/*.{ts,vue}"],
      "globals": {
        "definePageMeta": "readonly",
        "navigateTo": "readonly",
        "useRoute": "readonly",
        "useRouter": "readonly",
        "useHead": "readonly",
        "useSeoMeta": "readonly",
        "useFetch": "readonly",
        "useAsyncData": "readonly",
        "useLazyFetch": "readonly",
        "useLazyAsyncData": "readonly",
        "useState": "readonly",
        "useCookie": "readonly",
        "useNuxtApp": "readonly",
        "useRuntimeConfig": "readonly",
        "useRequestHeaders": "readonly",
        "useRequestEvent": "readonly",
        "createError": "readonly",
        "showError": "readonly",
        "clearError": "readonly",
        "defineNuxtRouteMiddleware": "readonly",
        "abortNavigation": "readonly",
        "addRouteMiddleware": "readonly",
        "setResponseStatus": "readonly",
        "getRequestURL": "readonly",
        "readBody": "readonly",
        "getQuery": "readonly",
        "getRouterParam": "readonly",
        "defineEventHandler": "readonly",
        "defineNitroPlugin": "readonly",
        "setCookie": "readonly",
        "getCookie": "readonly",
        "deleteCookie": "readonly",
        "sendRedirect": "readonly",
        "$fetch": "readonly",
        "refreshNuxtData": "readonly",
        "clearNuxtData": "readonly",
        "preloadRouteComponents": "readonly",
        "usePreviewData": "readonly",
        "onNuxtReady": "readonly",
        "isPrerendered": "readonly",
        "loadNuxtConfig": "readonly",
        "reloadNuxtApp": "readonly",
        "useError": "readonly",
        "setPageLayout": "readonly",
        "updatePageHead": "readonly",
        "onBeforeRouteLeave": "readonly",
        "onBeforeRouteUpdate": "readonly",
        "callOnce": "readonly",
        "withCtx": "readonly",
        "prerenderRoutes": "readonly",
        "importClients": "readonly",
        "importComponents": "readonly",
        "useId": "readonly"
      }
    }
  ]
}
